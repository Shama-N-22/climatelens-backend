# Copy this file to ".env" and fill it in.
PORT=8080

# LOCAL DEV: path to the service-account key file (kept OUT of git)
GEE_KEY_PATH=./service-account.json

# DEPLOYMENT (Render/Railway): instead of a file, paste the ENTIRE key JSON
# as one line into an env var named GEE_KEY_JSON and the server uses it:
# GEE_KEY_JSON={"type":"service_account","project_id":"...", ... }

# Optional CORS: your frontend origin, or * to allow all
CORS_ORIGIN=*